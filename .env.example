# Application Configuration
NEXT_PUBLIC_APP_NAME="JDP Admin Dashboard"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication (if implementing real auth later)
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Database (if implementing real database later)
DATABASE_URL="your-database-url-here"

# API Keys (if implementing external integrations)
NEXT_PUBLIC_QUICKBOOKS_CLIENT_ID="your-quickbooks-client-id"
QUICKBOOKS_CLIENT_SECRET="your-quickbooks-client-secret"

# Email Service (if implementing email notifications)
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER="your-email@example.com"
EMAIL_SERVER_PASSWORD="your-email-password"
EMAIL_FROM="noreply@example.com"

# Analytics (if implementing real analytics)
NEXT_PUBLIC_ANALYTICS_ID="your-analytics-id"

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_DARK_MODE=true